<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SpacedRead - Smart Reading & Revision Tracker</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-full flex flex-col">

    <!-- Top Navigation Header -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-30 shadow-md">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600 p-2 rounded-xl text-white shadow-lg shadow-indigo-500/30">
                    <i data-lucide="book-open-check" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="text-base font-bold tracking-tight text-white">SpacedRead Tracker</h1>
                    <p class="text-[11px] text-slate-400">Intervals: +1d → +3d → +7d → +15d</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <div class="hidden sm:flex items-center bg-slate-900/60 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-300">
                    <i data-lucide="calendar" class="w-3.5 h-3.5 mr-2 text-indigo-400"></i>
                    <span id="current-date-display">Today: Loading...</span>
                </div>
                <button onclick="openBackupModal()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-1.5 rounded-lg text-xs font-medium transition flex items-center">
                    <i data-lucide="database" class="w-3.5 h-3.5 mr-1.5"></i> Backup
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow w-full space-y-6">

        <!-- 1. LOG NEW READING SECTION (Now on top) -->
        <section class="bg-slate-800/90 border border-slate-700 rounded-2xl p-6 shadow-xl">
            <div class="mb-4">
                <h2 class="text-lg font-bold text-white flex items-center">
                    <i data-lucide="plus-circle" class="w-5 h-5 mr-2 text-indigo-400"></i> Log New Reading
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">Capture what you read today. Revisions are scheduled automatically.</p>
            </div>

            <form id="reading-form" onsubmit="handleNewReading(event)" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-medium text-slate-300 mb-1">Book / Subject Title</label>
                        <input type="text" id="book-title" required placeholder="e.g., Corporate Finance" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-300 mb-1">Number of Pages</label>
                        <input type="number" id="page-count" min="1" required placeholder="e.g., 25" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-slate-300 mb-1">Chapter / Pages Description</label>
                        <input type="text" id="chapter-name" required placeholder="e.g., Chapter 4: Valuation Models" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-300 mb-1">Date Read (Default: Today)</label>
                        <input type="date" id="read-date" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500">
                    </div>
                </div>

                <!-- Auto-Calculation Preview Box -->
                <div class="bg-slate-900/80 border border-slate-700/60 rounded-xl p-3.5 space-y-2">
                    <span class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">Scheduled Revision Preview</span>
                    <div id="schedule-preview" class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs text-slate-300">
                        <!-- Populated dynamically -->
                    </div>
                </div>

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2.5 px-4 rounded-xl transition shadow-lg shadow-indigo-600/30 flex items-center justify-center">
                    <i data-lucide="sparkles" class="w-4 h-4 mr-2"></i> Add & Schedule Revisions
                </button>
            </form>
        </section>

        <!-- 2. PENDING ITEMS FOR REVISION & QUEUE SECTION -->
        <section class="bg-slate-800/90 border border-slate-700 rounded-2xl p-6 shadow-xl">
            <!-- Tab Navigation & Search -->
            <div class="flex flex-wrap items-center justify-between border-b border-slate-700 pb-4 gap-4">
                <div class="flex space-x-2">
                    <button onclick="switchTab('queue')" id="tab-btn-queue" class="px-4 py-2 rounded-xl text-xs font-semibold transition bg-indigo-600 text-white shadow-md shadow-indigo-600/20 flex items-center">
                        <i data-lucide="check-square" class="w-4 h-4 mr-1.5"></i> Due Today <span id="queue-badge" class="ml-2 bg-indigo-800 text-indigo-200 px-1.5 py-0.5 rounded-full text-[10px]">0</span>
                    </button>
                    <button onclick="switchTab('all')" id="tab-btn-all" class="px-4 py-2 rounded-xl text-xs font-semibold transition text-slate-400 hover:text-white hover:bg-slate-700/50 flex items-center">
                        <i data-lucide="layers" class="w-4 h-4 mr-1.5"></i> All Chapters & Schedule
                    </button>
                    <button onclick="switchTab('forecast')" id="tab-btn-forecast" class="px-4 py-2 rounded-xl text-xs font-semibold transition text-slate-400 hover:text-white hover:bg-slate-700/50 flex items-center">
                        <i data-lucide="calendar-days" class="w-4 h-4 mr-1.5"></i> 14-Day Forecast
                    </button>
                </div>

                <div class="flex items-center space-x-2">
                    <input type="text" id="search-input" oninput="renderContent()" placeholder="Search chapters..." class="bg-slate-900 border border-slate-700 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none focus:border-indigo-500 w-40 sm:w-52">
                </div>
            </div>

            <!-- Tab Contents -->
            <div class="mt-6">
                
                <!-- Tab 1: Due Today Queue -->
                <div id="tab-content-queue" class="space-y-4">
                    <div class="flex items-center justify-between">
                        <h3 class="text-sm font-bold text-slate-200">Pending Revisions Due Today</h3>
                        <span id="queue-date-label" class="text-xs text-indigo-400 font-medium"></span>
                    </div>
                    <div id="queue-list" class="space-y-3">
                        <!-- Populated dynamically -->
                    </div>
                </div>

                <!-- Tab 2: All Chapters Master Table -->
                <div id="tab-content-all" class="space-y-4 hidden">
                    <h3 class="text-sm font-bold text-slate-200">Complete Master Reading Log</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-700 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                    <th class="pb-3 px-3">Book & Chapter</th>
                                    <th class="pb-3 px-3">Pages</th>
                                    <th class="pb-3 px-3">Read Date</th>
                                    <th class="pb-3 px-3">1st (+1d)</th>
                                    <th class="pb-3 px-3">2nd (+3d)</th>
                                    <th class="pb-3 px-3">3rd (+7d)</th>
                                    <th class="pb-3 px-3">4th (+15d)</th>
                                    <th class="pb-3 px-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="all-chapters-table" class="text-xs divide-y divide-slate-700/50 text-slate-300">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 3: 14-Day Forecast -->
                <div id="tab-content-forecast" class="space-y-4 hidden">
                    <h3 class="text-sm font-bold text-slate-200">Upcoming Workload & Page Loads (Next 14 Days)</h3>
                    <div id="forecast-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Populated dynamically -->
                    </div>
                </div>

            </div>
        </section>

        <!-- 3. STATS CARDS (Moved to bottom, smaller and compact) -->
        <section class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-3 flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Due Today</span>
                    <div class="mt-1 flex items-baseline space-x-1.5">
                        <span id="stat-due-today" class="text-xl font-bold text-white">0</span>
                        <span class="text-[11px] text-indigo-300 font-medium">(<span id="stat-due-pages">0</span> pgs)</span>
                    </div>
                </div>
                <div class="bg-amber-500/10 p-2 rounded-lg text-amber-400"><i data-lucide="clock" class="w-4 h-4"></i></div>
            </div>

            <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-3 flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Total Chapters</span>
                    <div class="mt-1 flex items-baseline">
                        <span id="stat-total-chapters" class="text-xl font-bold text-white">0</span>
                        <span class="ml-1 text-[11px] text-slate-400">active</span>
                    </div>
                </div>
                <div class="bg-indigo-500/10 p-2 rounded-lg text-indigo-400"><i data-lucide="book" class="w-4 h-4"></i></div>
            </div>

            <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-3 flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Completed Revisions</span>
                    <div class="mt-1 flex items-baseline">
                        <span id="stat-completed" class="text-xl font-bold text-white">0</span>
                        <span class="ml-1 text-[11px] text-slate-400">stages</span>
                    </div>
                </div>
                <div class="bg-emerald-500/10 p-2 rounded-lg text-emerald-400"><i data-lucide="check-circle-2" class="w-4 h-4"></i></div>
            </div>

            <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-3 flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Study Streak</span>
                    <div class="mt-1 flex items-baseline">
                        <span id="stat-streak" class="text-xl font-bold text-white">1</span>
                        <span class="ml-1 text-[11px] text-slate-400">days</span>
                    </div>
                </div>
                <div class="bg-rose-500/10 p-2 rounded-lg text-rose-400"><i data-lucide="flame" class="w-4 h-4"></i></div>
            </div>
        </section>

    </main>

    <!-- Backup / Data Modal -->
    <div id="backup-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-800 border border-slate-700 rounded-2xl max-w-md w-full p-6 space-y-6 shadow-2xl">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-bold text-white flex items-center">
                    <i data-lucide="database" class="w-5 h-5 mr-2 text-indigo-400"></i> Data Management
                </h3>
                <button onclick="closeBackupModal()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>
            <p class="text-xs text-slate-300">Export your reading database as a JSON backup or import an existing file to restore your schedule across devices.</p>
            <div class="flex flex-col space-y-3">
                <button onclick="exportData()" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold py-2.5 rounded-xl transition flex items-center justify-center">
                    <i data-lucide="download" class="w-4 h-4 mr-2"></i> Export Data (JSON)
                </button>
                <label class="w-full bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold py-2.5 rounded-xl transition flex items-center justify-center cursor-pointer">
                    <i data-lucide="upload" class="w-4 h-4 mr-2"></i> Import Data (JSON)
                    <input type="file" id="import-file" accept=".json" onchange="importData(event)" class="hidden">
                </label>
                <button onclick="loadSampleData()" class="w-full bg-slate-900 hover:bg-slate-950 border border-slate-700 text-slate-300 text-xs font-semibold py-2.5 rounded-xl transition flex items-center justify-center">
                    <i data-lucide="refresh-cw" class="w-4 h-4 mr-2"></i> Load Sample Study Data
                </button>
            </div>
        </div>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        let chapters = JSON.parse(localStorage.getItem('spaced_read_chapters')) || [];
        let currentTab = 'queue';

        const todayStr = new Date().toISOString().split('T')[0];
        document.getElementById('read-date').value = todayStr;
        document.getElementById('current-date-display').innerText = `Today: ${new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`;
        document.getElementById('queue-date-label').innerText = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });

        function calculateRevisions(dateStr) {
            const base = new Date(dateStr);
            const r1 = new Date(base); r1.setDate(base.getDate() + 1);
            const r2 = new Date(r1);   r2.setDate(r1.getDate() + 3);
            const r3 = new Date(r2);   r3.setDate(r2.getDate() + 7);
            const r4 = new Date(r3);   r4.setDate(r3.getDate() + 15);

            return {
                r1: r1.toISOString().split('T')[0],
                r2: r2.toISOString().split('T')[0],
                r3: r3.toISOString().split('T')[0],
                r4: r4.toISOString().split('T')[0]
            };
        }

        document.getElementById('read-date').addEventListener('change', updatePreview);
        function updatePreview() {
            const val = document.getElementById('read-date').value || todayStr;
            const revs = calculateRevisions(val);
            document.getElementById('schedule-preview').innerHTML = `
                <div><span class="text-slate-400">1st (+1d):</span> <span class="font-medium text-white">${revs.r1}</span></div>
                <div><span class="text-slate-400">2nd (+3d):</span> <span class="font-medium text-white">${revs.r2}</span></div>
                <div><span class="text-slate-400">3rd (+7d):</span> <span class="font-medium text-white">${revs.r3}</span></div>
                <div><span class="text-slate-400">4th (+15d):</span> <span class="font-medium text-white">${revs.r4}</span></div>
            `;
        }
        updatePreview();

        function handleNewReading(e) {
            e.preventDefault();
            const book = document.getElementById('book-title').value.trim();
            const chapter = document.getElementById('chapter-name').value.trim();
